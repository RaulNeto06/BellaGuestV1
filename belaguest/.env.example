# ============================================
# DATABASE CONFIGURATION
# ============================================

# MySQL Host
DB_HOST=mysql

# MySQL Port (optional, defaults to 3306)
# DB_PORT=3306

# MySQL User
DB_USER=belaguest_user

# MySQL Password
DB_PASSWORD=belaguest_pass

# Database Name
DB_NAME=belaguest

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server Port
PORT=3000

# Node Environment (development, production, test)
NODE_ENV=development

# ============================================
# JWT CONFIGURATION (AUTHENTICATION)
# ============================================

# JWT Secret Key (IMPORTANT: Change in production!)
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super_secret_change_me

# JWT Token Expiration Time (e.g., 1d, 7d, 24h)
JWT_EXPIRES_IN=1d

# ============================================
# LOGGING & DEBUG
# ============================================

# Log Level (error, warn, info, debug, trace)
LOG_LEVEL=debug

# Enable CORS (allow cross-origin requests)
CORS_ORIGIN=*

# ============================================
# NOTES
# ============================================

# - Never commit the actual .env file to version control
# - Use this .env.example as a template
# - Update JWT_SECRET before deploying to production
# - All required variables must be set, or the application will fail to start
